# ---------------------------------------------------------------------------
# apps/web environment variables (copy to .env.local and fill in).
# Everything prefixed NEXT_PUBLIC_ is baked into the browser bundle and visible
# to anyone, so NEVER put secrets here. The client secret belongs only in
# apps/api/.env: MSAL in the browser is a public client and does not use one.
# ---------------------------------------------------------------------------

# Directory (tenant) ID of the External ID tenant (for reference; MSAL uses the authority below).
NEXT_PUBLIC_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# Application (client) ID of the BharosaGhar app registration.
NEXT_PUBLIC_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# External ID authority: https://<subdomain>.ciamlogin.com/<tenant-id>
# <subdomain> is the part of the primary domain before ".onmicrosoft.com".
# Unlike Azure AD B2C, the user flow is NOT part of this URL: External ID picks the
# SignUpSignIn flow because the app is linked to it (User flows > SignUpSignIn > Applications).
NEXT_PUBLIC_ENTRA_AUTHORITY=https://yourtenant.ciamlogin.com/00000000-0000-0000-0000-000000000000

# Where Entra sends the browser back after sign-in/sign-out. Must exactly match a
# "Single-page application" redirect URI on the app registration (note the trailing slash).
NEXT_PUBLIC_ENTRA_REDIRECT_URI=http://localhost:3000/

# Scope the SPA requests so the access token is issued for the API
# (app registration > Expose an API): api://<client-id>/access_as_user
NEXT_PUBLIC_ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# Base URL of the NestJS API (apps/api).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
