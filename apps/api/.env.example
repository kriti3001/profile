# ---------------------------------------------------------------------------
# apps/api environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma (migrations + runtime client).
# Azure Database for PostgreSQL requires SSL, so keep `sslmode=require`.
# Special characters in the password (@ : / # ? etc.) must be URL-encoded.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Port the NestJS HTTP server listens on. Defaults to 3001 if unset
# (3000 is left free for the Next.js frontend in apps/web).
PORT=3001

# Runtime environment: development | production | test
NODE_ENV=development
