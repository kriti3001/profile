# ---------------------------------------------------------------------------
# apps/api environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma (migrations + runtime client).
# Azure Database for PostgreSQL requires SSL, so keep `sslmode=require`.
# Special characters in the password (@ : / # ? etc.) must be URL-encoded.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Port the NestJS HTTP server listens on. Defaults to 3001 if unset
# (3000 is left free for the Next.js frontend in apps/web).
PORT=3001

# Runtime environment: development | production | test
NODE_ENV=development

# Swagger UI is served at /docs unless NODE_ENV=production; set to true to force it on in production.
SWAGGER_ENABLED=false

# Public base URL of this API, used for Swagger's OAuth redirect (<url>/docs/oauth2-redirect.html).
# Defaults to http://localhost:<PORT> when unset.
API_PUBLIC_URL=http://localhost:3001

# Browser origins allowed to call the API (CORS), comma-separated.
CORS_ORIGINS=http://localhost:3000

# --- Microsoft Entra External ID (customer identity) -------------------------
# Directory (tenant) ID of the External ID tenant (Entra admin center > Overview).
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# Application (client) ID of the BharosaGhar app registration. Access tokens for
# this API must have it (or api://<client-id>) as their audience.
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Client secret of the app registration. NOT used for token validation (which only
# needs the tenant's public keys); reserved for future server-to-server calls such
# as Microsoft Graph. Backend only; never put this in apps/web.
ENTRA_CLIENT_SECRET=

# Primary domain of the tenant, e.g. yourtenant.onmicrosoft.com. The part before the
# first dot is used to build https://<subdomain>.ciamlogin.com for signing keys.
ENTRA_PRIMARY_DOMAIN=yourtenant.onmicrosoft.com

# --- Azure Blob Storage (photos and verification documents) ---------------------
# Storage account > Security + networking > Access keys > Connection string. Must include
# AccountKey (used to sign short-lived upload SAS URLs). Backend only; never put this in apps/web.
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=youraccount;AccountKey=REPLACE_ME;EndpointSuffix=core.windows.net"

# Container for property photos (served publicly: anonymous read access for blobs).
AZURE_STORAGE_PHOTOS_CONTAINER=property-photos

# Container for ID/ownership proofs. Must stay PRIVATE (no anonymous access).
AZURE_STORAGE_DOCS_CONTAINER=verification-docs

# Private staging container that clients upload into via SAS; files are checked and moved to the
# containers above when recorded. Created automatically (private) if missing.
AZURE_STORAGE_UPLOADS_CONTAINER=uploads
